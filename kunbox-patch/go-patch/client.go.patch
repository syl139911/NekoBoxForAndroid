// ============================================================
// sing/protocol/http/client.go 精简补丁
// 基于 sing-box v1.13.x 的 sing 库
// 功能: raw TCP CONNECT + delHost + path + 宽松响应解析
// ============================================================
//
// 使用方法:
//   1. 在 Client struct 里加字段: delHost bool
//   2. 在 Options struct 里加字段: DelHost bool
//   3. 在 NewClient 里赋值: client.delHost = options.DelHost
//   4. 替换整个 DialContext 方法
//
// ============================================================

// --- Client struct 新增字段 ---
// type Client struct {
//     ... (已有字段)
//     delHost    bool   // 不发送 Host header
// }

// --- Options struct 新增字段 ---
// type Options struct {
//     ... (已有字段)
//     DelHost    bool
// }

// --- NewClient 赋值 ---
// client.delHost = options.DelHost

// ============================================================
// 替换 DialContext 方法 (整个方法替换)
// ============================================================

func (c *Client) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
	network = N.NetworkName(network)
	switch network {
	case N.NetworkTCP:
	case N.NetworkUDP:
		return nil, os.ErrInvalid
	default:
		return nil, E.Extend(N.ErrUnknownNetwork, network)
	}

	conn, err := c.dialer.DialContext(ctx, N.NetworkTCP, c.serverAddr)
	if err != nil {
		return nil, err
	}

	// ================================================================
	// raw TCP CONNECT (替换 Go http.Request.Write)
	// ================================================================

	// --- 构建 CONNECT 目标 ---
	// path: 拼到 host:port 后面 (如 "host:443@gw.alicdn.com")
	var target string
	target = destination.String()
	if c.path != "" {
		target += c.path
	}

	var raw strings.Builder
	fmt.Fprintf(&raw, "CONNECT %s HTTP/1.1\r\n", target)

	// --- Host header ---
	// delHost=true: 不发送 Host header
	// 默认: Host = destination
	if !c.delHost {
		var hostValue string
		if c.host != "" {
			hostValue = c.host
		} else {
			hostValue = destination.String()
		}
		fmt.Fprintf(&raw, "Host: %s\r\n", hostValue)
	}

	// User-Agent
	fmt.Fprintf(&raw, "User-Agent: Go-http-client/1.1\r\n")

	// 自定义 headers
	hasProxyConnection := false
	if c.headers != nil {
		for key, values := range c.headers {
			if strings.ToLower(key) == "proxy-connection" {
				hasProxyConnection = true
			}
			for _, value := range values {
				fmt.Fprintf(&raw, "%s: %s\r\n", key, value)
			}
		}
	}

	// Proxy-Connection
	if !hasProxyConnection {
		fmt.Fprintf(&raw, "Proxy-Connection: Keep-Alive\r\n")
	}

	// Proxy-Authorization
	if c.username != "" {
		auth := c.username + ":" + c.password
		fmt.Fprintf(&raw, "Proxy-Authorization: Basic %s\r\n", base64.StdEncoding.EncodeToString([]byte(auth)))
	}

	raw.WriteString("\r\n")

	_, err = conn.Write([]byte(raw.String()))
	if err != nil {
		conn.Close()
		return nil, err
	}

	// ================================================================
	// 宽松响应解析 (接受非标准格式)
	// ================================================================
	reader := std_bufio.NewReader(conn)

	// 读取状态行
	statusLine, err := reader.ReadString('\n')
	if err != nil {
		conn.Close()
		return nil, E.New("failed to read proxy response: ", err)
	}
	statusLine = strings.TrimSpace(statusLine)

	// 读取 response headers
	for {
		line, readErr := reader.ReadString('\n')
		if line == "\r\n" || line == "\n" || readErr != nil {
			break
		}
	}

	// 检查状态码是否为 200
	// 接受: "HTTP/1.1 200 OK", "HTTP/1.0 200 OK", "200 OK", "200"
	hasValidStatus := false
	{
		trimmed := strings.TrimSpace(statusLine)
		if idx := strings.Index(trimmed, " "); idx >= 0 {
			trimmed = trimmed[idx+1:]
		}
		if strings.HasPrefix(trimmed, "200 ") || trimmed == "200" {
			hasValidStatus = true
		}
	}
	if !hasValidStatus {
		conn.Close()
		return nil, E.New("connect failed: ", statusLine)
	}

	// 连接建立成功
	if reader.Buffered() > 0 {
		buffer := buf.NewSize(reader.Buffered())
		_, err = buffer.ReadFullFrom(reader, buffer.FreeLen())
		if err != nil {
			conn.Close()
			return nil, err
		}
		conn = bufio.NewCachedConn(conn, buffer)
	}
	return conn, nil
}
